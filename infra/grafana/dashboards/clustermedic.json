    {
      "id": 18,
      "title": "Incidents by root cause (recurring issues)",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
